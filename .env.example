# Plantilla de configuración de PrecIA. Copia este fichero a .env y rellena solo lo que necesites.
# .env está en .gitignore: nunca subas claves al repositorio.

# Clave de la API de Anthropic (modos IA y Auto).
ANTHROPIC_API_KEY=

# Proxy propio (http://usuario:contraseña@servidor:puerto). Si está, manda sobre Evomi.
PRECIA_PROXY=

# Proxy residencial de Evomi: clave de su API y producto (por defecto rpc).
EVOMI_API_KEY=
EVOMI_PRODUCTO=

# País de salida del proxy (por defecto ES) y modo: bloqueo (por defecto), siempre o nunca.
PRECIA_PROXY_PAIS=
PRECIA_PROXY_MODO=

# 1 para arrancar con datos de ejemplo (igual que --demo).
PRECIA_DEMO=

# Alertas: cada cuántas horas se comprueban (por defecto 12; 0 lo desactiva; mínimo 1).
PRECIA_ALERTAS_CADA_H=

# Avisos por email: servidor de correo saliente, cuenta y destinatario. Siempre cifrado.
PRECIA_SMTP_SERVIDOR=
PRECIA_SMTP_USUARIO=
PRECIA_SMTP_CLAVE=
PRECIA_ALERTAS_EMAIL=
# Opcionales: puerto (587), seguridad (starttls o ssl) y remitente (el usuario).
PRECIA_SMTP_PUERTO=
PRECIA_SMTP_SEGURIDAD=
PRECIA_SMTP_REMITENTE=

# Avisos por Telegram: token del bot (de @BotFather) y número del chat o @canal.
PRECIA_TELEGRAM_TOKEN=
PRECIA_TELEGRAM_CHAT=
